# 本机 Chrome 或 Chromium 浏览器可执行文件路径，可选。
# 不配置时使用 Playwright 默认浏览器。
PLAYWRIGHT_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# 是否使用无头模式，默认 true。
# 如需看到浏览器窗口，请改为 false。
PLAYWRIGHT_HEADLESS=true

# 发送完成后是否自动关闭浏览器，默认 true。
# 如需按回车后再关闭，请改为 false。
AUTO_CLOSE=true

# true 时仅验证登录与好友定位，不输入或发送消息。定时续火使用 false。
DRY_RUN=false

# official-emoji：每天轮换聊天底栏官方表情；daily：轮换文本；default：沿用模板/一言。
SPARK_MESSAGE_MODE=official-emoji

# 发送一言时是否携带出处，默认 true。
YIYAN_INCLUDE_SOURCE=true

# 自定义火花消息模板，可选。配置说明见 README。
# SPARK_MESSAGE_TEMPLATE={{friend}}，今天的火花到账啦🔥\n{{yiyan}}\n——「{{from}}」\n{{date}} {{weekday}}

# 单账号配置。
DOUYIN_TARGET_NAMES='["暮邵落白"]'
DOUYIN_COOKIE='[{"domain":".douyin.com","expirationDate":1800175766.87008,"hostOnly":false,"httpOnly":false,"name":"UIFID","path":"/","sameSite":"no_restriction","secure":true,"session":false,"storeId":null,"value":"替换成真实 Cookie 值"}]'

# 多账号配置见 README。配置后会无视上面的单账号配置。
# DOUYIN_ACCOUNTS=
